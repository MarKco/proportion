    "recipes": [
        {
            "id": "b3b1a2e0-1a2b-4c3d-8e4f-5a6b7c8d9e01",
            "title": "Risotto allo zafferano",
            "servings": 4,
            "tags": [
                "builtin:first_course"
            ],
            "ingredients": [
                { "name": "builtin:carnaroli_rice", "qty": 320, "unit": "GRAM" },
                { "name": "builtin:saffron", "qty": 1, "unit": "SACHET" },
                { "name": "builtin:vegetable_stock", "qty": 1, "unit": "LITRE" },
                { "name": "builtin:onion", "qty": 0.5, "unit": "PIECE" },
                { "name": "builtin:butter", "qty": 40, "unit": "GRAM" },
                { "name": "builtin:parmesan", "qty": 60, "unit": "GRAM", "note": "grattugiato" },
                { "name": "builtin:white_wine", "qty": 100, "unit": "MILLILITRE" },
                { "name": "builtin:salt", "qty": null, "unit": "TO_TASTE", "display": "q.b." }
            ],
            "steps": [
                "Tritare la cipolla e farla appassire nel burro a fuoco basso.",
                "Aggiungere il riso e tostarlo per 2 minuti, mescolando.",
                "Sfumare con il vino bianco e lasciare evaporare.",
                "Aggiungere il brodo caldo un mestolo alla volta, mescolando spesso, per circa 18 minuti.",
                "A cottura ultimata, sciogliere lo zafferano in un mestolo di brodo e incorporarlo.",
                "Mantecare con burro e parmigiano fuori dal fuoco, aggiustare di sale."
            ],
            "notes": "Il riso deve restare all'onda, non asciutto.",
            "variants": [],
            "deletedAt": null,
            "updatedAt": 1767441600000,
            "createdAt": 1767441600000
        },
        {
            "id": "c4c2b3f1-2b3c-4d4e-9f5a-6b7c8d9e0f12",
            "title": "Torta di mele",
            "servings": 6,
            "tags": [
                "builtin:dessert",
                "builtin:oven",
                "Autunno"
            ],
            "ingredients": [
                { "name": "builtin:flour_00", "qty": 350, "unit": "GRAM" },
                { "name": "builtin:sugar", "qty": 200, "unit": "GRAM" },
                { "name": "builtin:butter", "qty": 100, "unit": "GRAM" },
                { "name": "builtin:egg", "qty": 3, "unit": "EGG" },
                { "name": "builtin:apple", "qty": 4, "unit": "PIECE" },
                { "name": "builtin:sweet_baking_powder", "qty": 1, "unit": "SACHET" },
                { "name": "builtin:salt", "qty": null, "unit": "TO_TASTE", "display": "un pizzico" }
            ],
            "steps": [
                "Sbattere le uova con lo zucchero fino a ottenere un composto chiaro e spumoso.",
                "Aggiungere il burro fuso, la farina setacciata con il lievito e un pizzico di sale.",
                "Incorporare le mele tagliate a pezzetti.",
                "Versare il composto in una teglia da 24 cm imburrata e infornare a 180°C per 45 minuti."
            ],
            "notes": null,
            "variants": [],
            "deletedAt": null,
            "updatedAt": 1767441600000,
            "createdAt": 1767441600000
        },
        {
            "id": "d5d3c4a2-3c4d-4e5f-a06b-7c8d9e0f1a23",
            "title": "Marmellata di fragole",
            "servings": null,
            "tags": [
                "builtin:preserves"
            ],
            "ingredients": [
                { "name": "builtin:strawberry", "qty": 1, "unit": "KILOGRAM" },
                { "name": "builtin:sugar", "qty": 700, "unit": "GRAM" },
                { "name": "builtin:lemon_juice", "qty": 2, "unit": "TABLESPOON" }
            ],
            "steps": [
                "Lavare, mondare e tagliare a pezzi le fragole.",
                "Metterle in una pentola con zucchero e succo di limone, lasciar macerare 2 ore.",
                "Cuocere a fuoco medio mescolando spesso finché non raggiunge la consistenza desiderata (circa 40 minuti).",
                "Invasare bollente in vasetti sterilizzati e capovolgere fino a raffreddamento."
            ],
            "notes": "Una ricetta senza porzioni: la resa dipende dalla quantità di frutta, non da un numero di persone.",
            "variants": [],
            "deletedAt": null,
            "updatedAt": 1767441600000,
            "createdAt": 1767441600000
        }
    ]
