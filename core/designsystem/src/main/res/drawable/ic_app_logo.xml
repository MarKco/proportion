<?xml version="1.0" encoding="utf-8"?>
<!--
  App logo for in-app use (e.g. a top app bar): the launcher icon's foreground
  only, no background fill, so it sits directly on whatever surface hosts it
  instead of reading as a coin. The launcher icon itself is unrelated
  (app/src/main/res/drawable/ic_launcher_background.xml and
  ic_launcher_foreground.xml) and is not touched here.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group>
        <!-- side wall, left sliver, under the butter wedge's own edge (darker butter) -->
        <path
            android:fillColor="#CEB066"
            android:strokeColor="#1D2621"
            android:strokeWidth="2.4"
            android:strokeLineJoin="round"
            android:pathData="M24,58 A30,17 0 0,0 32,69.56 L32,78.56 A30,17 0 0,1 24,67 Z" />

        <!-- side wall, front (darker rose) - one panel spanning the centre symmetrically, matching the front wedge above it -->
        <path
            android:fillColor="#C98CA1"
            android:strokeColor="#1D2621"
            android:strokeWidth="2.4"
            android:strokeLineJoin="round"
            android:pathData="M32,69.56 A30,17 0 0,0 76,69.56 L76,78.56 A30,17 0 0,1 32,78.56 Z" />

        <!-- side wall, right sliver, under the apricot wedge's own edge (darker apricot) -->
        <path
            android:fillColor="#D28F6C"
            android:strokeColor="#1D2621"
            android:strokeWidth="2.4"
            android:strokeLineJoin="round"
            android:pathData="M76,69.56 A30,17 0 0,0 84,58 L84,67 A30,17 0 0,1 76,78.56 Z" />

        <!-- top face, right wedge (apricot) -->
        <path
            android:fillColor="#F4B393"
            android:strokeColor="#1D2621"
            android:strokeWidth="2.4"
            android:strokeLineJoin="round"
            android:pathData="M54,58 L54,41 A30,17 0 0,1 76,69.56 Z" />

        <!-- top face, front wedge (rose) -->
        <path
            android:fillColor="#EFB0C4"
            android:strokeColor="#1D2621"
            android:strokeWidth="2.4"
            android:strokeLineJoin="round"
            android:pathData="M54,58 L76,69.56 A30,17 0 0,1 32,69.56 Z" />

        <!-- top face, left wedge (butter) -->
        <path
            android:fillColor="#F2D48A"
            android:strokeColor="#1D2621"
            android:strokeWidth="2.4"
            android:strokeLineJoin="round"
            android:pathData="M54,58 L32,69.56 A30,17 0 0,1 54,41 Z" />

        <!-- candle left -->
        <path
            android:fillColor="#FFF6E2"
            android:strokeColor="#1D2621"
            android:strokeWidth="2.2"
            android:strokeLineJoin="round"
            android:pathData="M36,58 L36,41 L42,41 L42,58 Z" />
        <path
            android:fillColor="#F49B5F"
            android:strokeColor="#1D2621"
            android:strokeWidth="1.8"
            android:pathData="M39,40 C42,36 41.5,32 39,29 C36.5,32 36,36 39,40 Z" />

        <!-- candle centre -->
        <path
            android:fillColor="#FFF6E2"
            android:strokeColor="#1D2621"
            android:strokeWidth="2.2"
            android:strokeLineJoin="round"
            android:pathData="M51,53 L51,34 L57,34 L57,53 Z" />
        <path
            android:fillColor="#F49B5F"
            android:strokeColor="#1D2621"
            android:strokeWidth="1.8"
            android:pathData="M54,33 C57,29 56.5,24 54,21 C51.5,24 51,29 54,33 Z" />

        <!-- candle right -->
        <path
            android:fillColor="#FFF6E2"
            android:strokeColor="#1D2621"
            android:strokeWidth="2.2"
            android:strokeLineJoin="round"
            android:pathData="M66,58 L66,41 L72,41 L72,58 Z" />
        <path
            android:fillColor="#F49B5F"
            android:strokeColor="#1D2621"
            android:strokeWidth="1.8"
            android:pathData="M69,40 C72,36 71.5,32 69,29 C66.5,32 66,36 69,40 Z" />
    </group>
</vector>
