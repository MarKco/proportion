<?xml version="1.0" encoding="utf-8"?>
<!--
  Clipart-style 3D pie chart with candles.
  Top face: ellipse centred at (54,58), rx 30, ry 17, cut into three wedges.
  Side wall: 9dp extrusion, each panel a darker shade of the wedge above it.
  Everything sits inside the 66dp adaptive-icon safe zone.
-->
