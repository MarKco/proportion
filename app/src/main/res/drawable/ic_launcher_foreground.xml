        android:fillColor="#CEB066"
        android:strokeColor="#1D2621"
        android:strokeWidth="2.4"
        android:strokeLineJoin="round"
        android:pathData="M24,58 A30,17 0 0,0 32,69.56 L32,78.56 A30,17 0 0,1 24,67 Z" />

    <!-- side wall, front (darker rose) - one panel spanning the centre symmetrically, matching the front wedge above it -->
