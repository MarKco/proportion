<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".ProPortionApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProPortion">

        <!-- adjustResize, not the system default: without it the window is *panned* up when the
             keyboard opens, which shifts every window coordinate while the scroll state stays put.
             The editor scrolls a focused ingredient row into view using those coordinates, so a
             pan on top of that scroll pushed the row off the top of the screen (and let go again
             on the next keystroke). With adjustResize the keyboard is reported through the ime
             insets the editor already reads, and the window itself stays where it is. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ProPortion"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Opening a .proportion attachment or file lands in the app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.proportion" />
                <data android:pathPattern=".*\\..*\\.proportion" />
            </intent-filter>
        </activity>

        <!-- Lets AppCompat remember the app-language choice on its own, on every Android version
             this app supports, instead of the app keeping a second copy of that state. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
